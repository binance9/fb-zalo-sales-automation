# .env.example — DANH SÁCH TÊN BIẾN MÔI TRƯỜNG (SURI P2, hạng mục 6)
#
# Cách dùng: copy thành `.env.live` (cùng thư mục với server.js) rồi điền giá trị thật.
# server tự nạp `.env.live` lúc boot (src/live-env.js loadEnvFile) — biến môi trường CÓ SẴN
# trong hệ điều hành luôn THẮNG giá trị trong file (file chỉ điền-thêm).
#
# CỨM SECRETS: file này chứa token/key — KHÔNG commit lên git, KHÔNG chia sẻ; chỉ chủ shop giữ.
# UI/API KHÔNG BAO GIỜ hiển thị lại giá trị (chỉ masked *** + 4 ký tự cuối).

# ================= HỒ SƠ SHOP (bước 1 wizard — nên điền qua UI Cài đặt, không cần env) =================
# Nếu điền qua UI (onboarding 7 bước) thì settings shop thắng env — env chỉ là phương án khai nhanh.

# ================= FACEBOOK MESSENGER (bước 2) =================
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# ================= ZALO OA (bước 3) =================
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# ================= GHN — ĐƠN VỊ VẬN CHUYỂN (bước 5) =================
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

# ================= AI PROVIDER (bước 6 — DeepSeek) =================
# Khuyến nghị: KHÔNG điền key AI ở env — dùng nút "Nối key DeepSeek (live)" trong Cài đặt
# (đọc key từ file provider config của chủ qua biến dưới đây). Key vào settings shop, mask khi xem.
DEEPSEEK_PROVIDER_CONFIG=C:\GaAi-Lab-Test\GaAiLab\backup\model-rename-20261004\provider_config.json

# ================= WEBHOOK =================
WEBHOOK_PUBLIC_BASE=

# ================= CHẾ ĐỘ CHẠY (đa số để mặc định) =================
# CHANNEL_MODE  : mock | live   (biên kênh Meta/Zalo; mặc định mock)
# SHIPPING_MODE : mock | live   (biên GHN; mặc định mock)
# APP_DATA_MODE : persist | reset (persist = giữ dữ liệu khi restart; reset chỉ dùng cho test)
# PORT          : cổng HTTP (mặc định 8080)
# UI_DEMO       : 1 | 0 (1 = seed dữ liệu demo + bot bật cho shop mới; 0 = shop trống, bot OFF)
# NO_BROWSER_OPEN : 1 = không tự mở trình duyệt khi boot
# GHN_WEBHOOK_TOKEN   : token xác thực webhook GHN gọi vào (tuỳ chọn)
# ZALO_APP_SECRET     : (đã liệt kê ở nhóm Zalo — dùng verify chữ ký X-ZEvent-Signature)
